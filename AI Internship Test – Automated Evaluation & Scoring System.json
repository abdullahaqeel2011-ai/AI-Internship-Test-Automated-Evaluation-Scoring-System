    {
      "parameters": {
        "jsCode": "// ✅ FINAL CORRECT ANSWERS\nconst correctAnswers = {\n  Q1: \"Add a condition to check if the record already exists\",\n  Q2: \"Reduce manual tasks\",\n  Q3: \"Loop through each customer\",\n  Q4: \"Pause between actions\",\n  Q5: \"Split data into smaller chunks\",\n  Q6: \"Pagination and batching\",\n  Q7: \"Assigning input data to output fields\",\n  Q8: \"Correct endpoint and data format\",\n  Q9: \"Round-robin assignment\",\n  Q10: \"Validate data before processing\",\n  Q11: \"Prevent workflow from triggering itself\",\n  Q12: \"Conditional comparison\",\n  Q13: \"Track events and errors for debugging\",\n  Q14: \"Unstable trigger data\",\n  Q15: \"Test with sample data\",\n  Q16: \"Data merging\",\n  Q17: \"Conditional logic\",\n  Q18: \"Batch processing\",\n  Q19: \"Error notification step\",\n  Q20: \"Ensures reliability before deployment\"\n};\n\nconst items = $input.all();\n\nconst normalize = (text) =>\n  String(text)\n    .toLowerCase()\n    .replace(/\\s+/g, \" \")\n    .replace(/[^\\w\\s]/g, \"\")\n    .trim();\n\nreturn items.map(item => {\n  const responses = item.json;\n  let score = 0;\n\n  for (const key in correctAnswers) {\n    const correct = normalize(correctAnswers[key]);\n    const answer = responses[key];\n\n    if (!answer) continue;\n\n    // ✅ HANDLE CHECKBOX (ARRAY)\n    if (Array.isArray(answer)) {\n      const matched = answer.some(opt =>\n        normalize(opt).includes(correct)\n      );\n      if (matched) score++;\n    }\n    // ✅ HANDLE SINGLE VALUE\n    else {\n      if (normalize(answer).includes(correct)) {\n        score++;\n      }\n    }\n  }\n\n  responses.score = score;\n  responses.total = 20;\n  return { json: responses };\n});"
      },
